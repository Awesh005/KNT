PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/knt_welfare

# JWT Secret
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default Super Admin
ADMIN_EMAIL=admin@kntwelfare.org
ADMIN_PASSWORD=change_this_default_password

# CORS
CLIENT_URL=http://localhost:5173

# Email Configuration (Optional for now)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=kntworldwelfarefoundationfound@gmail.com
# Public API origin SBI will POST back to (production domain, or http://localhost:5001 in local tests)
API_PUBLIC_URL=http://localhost:5001

# SBI ePay — leave blank until merchant credentials arrive. UPI screenshot stays as fallback.
SBI_MERCHANT_ID=
SBI_ENCRYPTION_KEY=
SBI_GATEWAY_URL=https://www.sbiepay.sbi/secure/AggregatorHostedListener
# Optional: UAT https://test.sbiepay.sbi/secure/AggregatorHostedListener
SBI_VERIFY_URL=
SBI_REFUND_URL=
SBI_RETURN_URL=
# Blank = all pay modes on SBI hosted page
SBI_PAYMODE=

